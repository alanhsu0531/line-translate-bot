# LINE Messaging API
CHANNEL_ACCESS_TOKEN=你的LINE频道访问令牌
CHANNEL_SECRET=你的LINE频道密钥

# OpenRouter
OPENROUTER_API_KEY=你的OpenRouter API密钥

# 模型选择（可选，默认 minimax-m3）
OPENROUTER_MODEL=minimax/minimax-m3:free

# 翻译温度（可选，默认 0.3）
# 越低越精确（0.0-0.3），越高越自然（0.5-1.0）
OPENROUTER_TEMPERATURE=0.3

# 服务器端口（Render 自动设置 PORT 环境变量）
PORT=3000
